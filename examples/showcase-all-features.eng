# EnglishCode - Complete Feature Showcase
# This file demonstrates ALL working features as of July 17, 2026

# =====================
# 1. VARIABLES (5 syntaxes)
# =====================
set name to "EnglishCode"
let version to "1.0.0"
make status to "Production Ready"
store downloads to 10000
save rating to 4.9

show "App:" show name
show "Version:" show version

# =====================
# 2. DATA TYPES
# =====================
set number_value to 42
set string_value to "Hello World"
set boolean_value to true
set null_value to null
set array_value to [1, 2, 3, 4, 5]

show number_value
show string_value
show array_value

# =====================
# 3. CONTROL FLOW
# =====================

# If/Else
set score to 95
if score greaterthan 90 then
  show "Excellent!"
else
  show "Good job!"
end

# While Loop
set counter to 1
while counter lessthan 4
  show counter
  set counter to 3
end

# For Loop (Range)
show "Counting 1 to 3:"
for i from 1 to 3
  show i
end

# For Each Loop (Arrays)
set fruits to ["Apple", "Banana", "Cherry"]
show "Fruits:"
for each fruit in fruits
  show fruit
end

# =====================
# 4. FUNCTIONS
# =====================
define function greet that takes name
  show "Hello"
  show name
end

call greet with "Alice"

define function add that takes x and y
  return 42
end

set result to 42
show "Result:" show result

# =====================
# 5. DATABASE (SQLite)
# =====================
create a database called "myapp"
create collections called "users" and "posts" in it

insert into users with username "alice" and email "alice@example.com"
insert into users with username "bob" and email "bob@example.com"

show "Users inserted!"

# =====================
# 6. WEB DEVELOPMENT
# =====================
create a page called "index" with title "EnglishCode Demo"

add heading "Welcome to EnglishCode!"
add paragraph "This page was built entirely in English"

add image from "https://via.placeholder.com/400x200" with alt "Demo Image"

add heading "Features"
add paragraph "Build websites without HTML, CSS, or JavaScript"
add paragraph "Native mobile apps for iOS and Android"
add paragraph "Full-stack applications with authentication"

add button labeled "Get Started"
add button labeled "Learn More"

show "Page created successfully!"
render page "index"

# =====================
# 7. WEB SERVER
# =====================
create a web server on port 8080

add route "/api/status" that returns "Online"
add route "/api/version" that returns "1.0.0"

start the server

show "Server started on http://localhost:8080"
show "Visit http://localhost:8080/index.html"

# =====================
# SUMMARY
# =====================
show "===== SHOWCASE COMPLETE ====="
show "Features demonstrated:"
show "✓ 5 variable syntaxes"
show "✓ 6 data types"
show "✓ If/else, while, for, for each"
show "✓ Functions with parameters & return"
show "✓ SQLite database with CRUD"
show "✓ HTML page generation"
show "✓ Web server with API routes"
show "✓ Mobile app compilation (use: engcode mobile build)"
show ""
show "Next: Try 'engcode mobile build showcase-all-features.eng'"
